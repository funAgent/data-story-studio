{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Story Motion Project v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "width",
    "height",
    "fps",
    "durationFrames",
    "theme",
    "source",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "width": {
      "const": 1280
    },
    "height": {
      "const": 720
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 30,
      "maximum": 1800
    },
    "theme": {
      "type": "object",
      "required": [
        "background",
        "foreground",
        "accent",
        "muted"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "columns",
        "rows",
        "label",
        "valuePrefix",
        "valueSuffix"
      ],
      "properties": {
        "columns": {
          "const": [
            "category",
            "value"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 140,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "valuePrefix": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "valueSuffix": {
          "type": "string",
          "maxLength": 12,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "maxLength": 20,
                "pattern": "^[^\\u0000-\\u001f]*$",
                "minLength": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000.0
              }
            ]
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "start",
          "duration",
          "title",
          "subtitle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f]*$",
            "minLength": 1
          },
          "type": {
            "enum": [
              "headline",
              "barChart",
              "summary"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "duration": {
            "type": "integer",
            "minimum": 30,
            "maximum": 1800
          },
          "title": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "subtitle": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "metric": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "metricLabel": {
            "type": "string",
            "maxLength": 140,
            "pattern": "^[^\\u0000-\\u001f]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "headline",
                    "summary"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "metric",
                "metricLabel"
              ]
            }
          }
        ]
      }
    },
    "snapshot": {
      "type": "object",
      "description": "Retained original snapshot, raw-byte SHA-256, selected chart and aggregation/warnings."
    }
  }
}
